# せつめいナビ 院内サーバー 環境変数の例
# このファイルを .env にコピーして、値を必ず書き換えてください。
# .env は Git にコミットされません（.gitignore で除外しています）。

PORT=8080

# 院内LANのみに限定する場合は、該当NICのIPアドレスを指定してください。
# 例）HOST=192.168.10.20
HOST=0.0.0.0

DATA_DIR=./data

# API を呼ぶための共有トークン。必ず推測されにくい値へ変更してください。
# 生成例： openssl rand -hex 32
SETSUMEI_TOKEN=change-me

# CORS 許可オリジン。院内の配信元URLを指定するのが安全です。
# 例）ALLOW_ORIGIN=http://192.168.10.20:8080
ALLOW_ORIGIN=*

# 説明実施記録の保持日数（既定5年）。過ぎた記録は起動時に削除されます。
RECORD_RETENTION_DAYS=1825
